# OpenAI-compatible LLM API (never commit a real key)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini

# Aliases (optional). Used if the LLM_* variables above are unset.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Local speech-to-text (faster-whisper)
# tiny | tiny.en | base | base.en | small | small.en | medium | large-v3
WHISPER_MODEL=base
# auto | cpu | cuda
WHISPER_DEVICE=auto
# Leave empty for automatic language detection, or set e.g. en, es, fr, id
WHISPER_LANGUAGE=

# Desktop UI server (local only by default)
HOST=127.0.0.1
PORT=8765
